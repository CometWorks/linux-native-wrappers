# CMake out-of-tree build directories (produced by `make` and by the
# per-configuration builds in the build workflow).
/build/
/build-release/
/build-debug/

# Local packaging output (produced by ./build_and_package.sh) and the
# workflow's per-game staging trees.
/out/
/out-*/
/dist/

# Proprietary Windows DLLs used by optional local integration tests.
/Havok.dll
/VRage.Physics.Client.dll
/VRage.Physics.Native.dll
/VRage.Physics.dll

# Python bytecode caches.
__pycache__/

# CLion
/.idea/
/cmake-build-debug
/cmake-build-release
